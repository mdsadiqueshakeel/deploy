# User Service Environment Variables
NODE_ENV=development
PORT=5001
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/mlm_db
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Email Configuration
EMAIL_SERVICE=gmail
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# URLs
FRONTEND_URL=http://localhost:3000
USER_SERVICE_URL=http://user-service:5001

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:5001,http://localhost:5002