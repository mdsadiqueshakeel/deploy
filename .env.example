# Docker Compose Environment Variables

# MongoDB Connection
# For local development with Docker
MONGO_URI=mongodb://mongodb:27017/MLM_DB
# For MongoDB Atlas (production)
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/MLM_DB?retryWrites=true&w=majority

# Security
JWT_SECRET=your_jwt_secret_key_here

# Services URLs (for internal Docker network communication)
# These are already set in docker-compose.yml, but can be overridden here if needed
# USER_SERVICE_URL=http://user-service:5001
# ADMIN_SERVICE_URL=http://admin-service:5002
# API_GATEWAY_URL=http://api-gateway:5000

# Email Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Other Configuration
NODE_ENV=development